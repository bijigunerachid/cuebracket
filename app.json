{
  "expo": {
    "name": "CueBracket",
    "slug": "cuebracket",
    "scheme": "cuebracket",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.cuebracket.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": false
    },
    "platforms": ["android"]
  }
}
