{
  "expo": {
    "name": "CueBracket",
    "slug": "cuebracket",
    "scheme": "cuebracket",
    "version": "1.0.0",
    "icon": "./assets/brand/cuebracket-logo.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#07110F",
      "enforceContrast": false
    },
    "android": {
      "package": "com.cuebracket.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/cuebracket-logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F0D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "platforms": ["android"],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "32743886-63a5-41c0-860e-013d8a9728d9"
      }
    },
    "owner": "biijigune"
  }
}
